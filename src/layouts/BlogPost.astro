---
import { Image } from 'astro:assets';
import FormattedDate from '../components/FormattedDate.astro';
import type { Post } from '../posts';
import { readingTime } from '../posts';
import Base from './Base.astro';

interface Props {
	post: Post;
}

const { post } = Astro.props;
const { title, description, pubDate, updatedDate, heroImage, tags, draft } = post.data;
---

<Base title={title} description={description} image={heroImage?.src} type="article">
	<article>
		<header class="post-header">
			<p class="eyebrow">
				<FormattedDate date={pubDate} /> · {readingTime(post.body)} min read
				{draft && <span class="tag">draft</span>}
			</p>
			<h1>{title}</h1>
			{
				updatedDate && (
					<p class="muted updated">
						Updated <FormattedDate date={updatedDate} />
					</p>
				)
			}
		</header>
		{heroImage && <Image class="hero" width={1024} height={512} src={heroImage} alt="" />}
		<div class="prose">
			<slot />
		</div>
		{
			tags.length > 0 && (
				<p class="tags">
					{tags.map((tag) => (
						<a class="tag" href={`/tags/${tag}/`}>
							{tag}
						</a>
					))}
				</p>
			)
		}
		<hr />
		<p><a href="/blog/">← All posts</a></p>
	</article>
</Base>
<style>
	.post-header {
		margin-bottom: 2rem;
	}
	.updated {
		font-size: 0.9rem;
		margin: -0.25rem 0 0;
	}
	.hero {
		width: 100%;
		margin-bottom: 2rem;
	}
	.tags {
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem;
		margin-top: 2rem;
	}
</style>
