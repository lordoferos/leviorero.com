---
import type { Post } from '../posts';
import FormattedDate from './FormattedDate.astro';

interface Props {
	posts: Post[];
}

const { posts } = Astro.props;
---

<ul class="posts">
	{
		posts.map((post) => (
			<li>
				<a href={`/blog/${post.id}/`}>
					<span class="title">
						{post.data.title}
						{post.data.draft && <span class="tag">draft</span>}
					</span>
					<span class="date">
						<FormattedDate date={post.data.pubDate} />
					</span>
				</a>
				<p class="desc">{post.data.description}</p>
			</li>
		))
	}
</ul>
<style>
	.posts {
		list-style: none;
		padding: 0;
		margin: 0;
	}
	li {
		padding: 1.1rem 0;
		border-bottom: 1px solid var(--border);
	}
	li:first-child {
		padding-top: 0;
	}
	a {
		display: flex;
		flex-wrap: wrap;
		justify-content: space-between;
		align-items: baseline;
		gap: 0 1rem;
		text-decoration: none;
	}
	.title {
		font-family: var(--serif);
		font-size: 1.2rem;
		font-weight: 600;
		color: var(--text);
	}
	a:hover .title {
		color: var(--accent);
	}
	.date {
		font-size: 0.85rem;
		color: var(--muted);
		white-space: nowrap;
	}
	.desc {
		margin: 0.25rem 0 0;
		color: var(--muted);
		font-size: 0.95rem;
	}
</style>
